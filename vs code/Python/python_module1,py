print=functools.partial(print,flush=True#ON)

#helper functions 
def get_float(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return float(input())
        except ValueError:
            print("Invalid input. Please type a number (eg:, 3.5).")
        except EOFError:
            print("\n No input received, Existing program.")
        raise SystemExit
def get_int(prompt)
 while True:
