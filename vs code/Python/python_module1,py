            return int(input())
        except ValueError:
            print("Invalid input. Please type a number (eg:, 3.5).")
        except EOFEroor:
            print("\n No input received, Existing program.")
        raise SystemExit
def safe_input(prompt):
    try:
        print(prompt, end="",flush=True)
        sys.stdout.flush()
        return input()
    except EOFError:
        print("\n No input received. Existing program.")
        raise SystemExit

